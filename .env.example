# Copiá este archivo a .env y completá los valores del proyecto Supabase.
# Sólo se exponen al navegador las variables con prefijo VITE_.

# URL del proyecto Supabase (Settings → API → Project URL).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública (Settings → API → anon public).
# Es pública por diseño: la seguridad la da Row Level Security, no esta clave.
# NUNCA pongas acá la service_role key.
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Fase 1: ninguna de las dos se usa todavía. Se conectan en la Fase 2.
